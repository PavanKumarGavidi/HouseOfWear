# ============================================
# House Of Wear - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control

# ── Supabase ──────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: NEVER expose to client bundle
# Used in edge functions / server routes only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Razorpay ──────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Server-only: used for order creation and verification
RAZORPAY_KEY_SECRET=your-razorpay-secret-here
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here

# ── Resend (Email) ────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── MSG91 (SMS/WhatsApp OTP) ─────────────────
# Get from: https://control.msg91.com → API Key
MSG91_AUTH_KEY=your-msg91-auth-key-here
MSG91_TEMPLATE_ID=your-template-id

# ── App Config ────────────────────────────────
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=House Of Wear

# ── Analytics (optional) ──────────────────────
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
